{
  "name": "child-dinosaur",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render episode1 out/episode1.mp4",
    "render:2": "remotion render episode2 out/episode2.mp4",
    "thumbnail": "remotion still thumbnail-episode1 out/thumb1.png",
    "thumbnail:2": "remotion still thumbnail-episode2 out/thumb2.png",
    "voice": "node scripts/generate-voice.mjs",
    "voice:2": "node scripts/generate-voice.mjs --episode episode2",
    "dinos": "node scripts/build-dinos.mjs",
    "cries": "node scripts/generate-cries.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.2.0",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media-utils": "4.0.532",
    "@remotion/three": "4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
